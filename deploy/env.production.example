# Salin ke /var/www/bangku/.env lalu isi bagian bertanda <...>. Jangan pernah di-commit.
APP_NAME="Bangku Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<kasir.contoh.id>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
# localhost = socket MySQL (cocok dengan user 'bangku'@'localhost' di docs/pasang-vps.md).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bangku
DB_USERNAME=bangku
DB_PASSWORD=<sandi-database-panjang-acak>

# Sesi & cache di database (batas salah PIN butuh operasi atomik: database sudah memenuhi).
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Akun owner pertama (dibuat saat db:seed pertama). Hapus ADMIN_PASSWORD dari file ini setelah pemasangan.
ADMIN_PANEL_PATH=admin
ADMIN_NAME=Owner
ADMIN_EMAIL=<email-owner>
ADMIN_PASSWORD=<sandi-owner-minimal-12-karakter>
ADMIN_RESET_PASSWORD=false

SHADCN_STYLE=nova
SHADCN_BASE_COLOR=zinc
SHADCN_PRIMARY=default
SHADCN_SIDEBAR=inset
SHADCN_AUTH_LAYOUT=muted
SHADCN_SHOWCASE=false
SHADCN_NATIVE_DATE_PICKERS=false

PASSWORD_MIN_LENGTH=12
PASSWORD_UNCOMPROMISED=true
SECURITY_HSTS_MAX_AGE=31536000
CSP_HEADER=

VITE_APP_NAME="${APP_NAME}"
